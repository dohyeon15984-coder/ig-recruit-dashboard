# 서버 포트 (선택, 기본값 3000)
PORT=3000

# --- 아래 두 값은 SETUP.md 가이드를 따라 발급받은 뒤 채워넣으세요 ---
# Instagram(Facebook) Graph API 장기 액세스 토큰 (60일 유효)
IG_ACCESS_TOKEN=

# Instagram 비즈니스 계정 ID (숫자)
IG_BUSINESS_ACCOUNT_ID=

# 토큰을 발급/갱신한 날짜 (YYYY-MM-DD). 대시보드 상단 만료 D-day 배너 계산에 사용됩니다.
IG_TOKEN_ISSUED_AT=

# --- scripts/refresh-token.js 로 토큰을 갱신할 때만 필요 (앱 대시보드에서 확인) ---
FB_APP_ID=
FB_APP_SECRET=

# --- Meta가 배포 서버(Render 등) IP를 막아 거기서 직접 동기화가 안 될 때만 필요 ---
# 로컬 PC와 배포 서버 양쪽에 "같은 값"을 넣어두세요. scripts/push-to-remote.js 가 이 값으로 인증해요.
ADMIN_SYNC_SECRET=

# 배포된 대시보드 URL. 설정해두면 "지금 동기화" 버튼(및 daily-sync-and-push.ps1)이
# 로컬 동기화 직후 이 주소로 데이터를 자동 전송합니다. (예: https://ig-recruit-dashboard.onrender.com)
REMOTE_DASHBOARD_URL=
